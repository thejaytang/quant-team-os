{
  "realm": "quant-team-os",
  "enabled": true,
  "roles": {
    "realm": [
      {"name": "admin"},
      {"name": "researcher"},
      {"name": "risk_reviewer"},
      {"name": "approver"},
      {"name": "viewer"},
      {"name": "service_account"}
    ]
  },
  "users": [
    {
      "username": "qto-admin",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{"type": "password", "value": "admin", "temporary": false}],
      "realmRoles": ["admin", "researcher", "risk_reviewer", "approver", "viewer"]
    },
    {
      "username": "qto-researcher",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{"type": "password", "value": "researcher", "temporary": false}],
      "realmRoles": ["researcher", "viewer"]
    },
    {
      "username": "qto-approver",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{"type": "password", "value": "approver", "temporary": false}],
      "realmRoles": ["approver", "viewer"]
    },
    {
      "username": "service-account-openbb-backend",
      "enabled": true,
      "emailVerified": true,
      "serviceAccountClientId": "openbb-backend",
      "realmRoles": ["researcher", "viewer", "service_account"]
    }
  ],
  "clients": [
    {
      "clientId": "control-ui",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:5173/*", "http://127.0.0.1:5173/*"],
      "webOrigins": ["http://localhost:5173", "http://127.0.0.1:5173"],
      "protocolMappers": [
        {
          "name": "api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {"clientId": "api", "enabled": true, "publicClient": false, "serviceAccountsEnabled": true},
    {
      "clientId": "chainlit",
      "enabled": true,
      "publicClient": false,
      "secret": "chainlit-local-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:8001/*", "http://127.0.0.1:8001/*"],
      "webOrigins": ["http://localhost:8001", "http://127.0.0.1:8001"],
      "protocolMappers": [
        {
          "name": "api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "openbb-backend",
      "enabled": true,
      "publicClient": false,
      "secret": "openbb-backend-local-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "protocolMappers": [
        {
          "name": "api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {"clientId": "superset", "enabled": true, "publicClient": true},
    {"clientId": "jupyterlab", "enabled": true, "publicClient": true},
    {"clientId": "mlflow", "enabled": true, "publicClient": true},
    {"clientId": "langfuse", "enabled": true, "publicClient": true}
  ]
}
